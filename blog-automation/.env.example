# ============================================================
#  블로그 수익화 자동화 - 환경변수 설정
#  이 파일을 복사해서 .env 로 저장하고 값을 채우세요.
#      cp .env.example .env
#  .env 는 절대 git 에 커밋하지 마세요 (.gitignore 에 포함됨)
# ============================================================

# --- Claude API (콘텐츠 생성) ---
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# 사용할 모델 (기본값 권장)
CLAUDE_MODEL=claude-sonnet-5

# --- 네이버 검색광고 API (검색량/키워드 조사) ---
# https://searchad.naver.com 광고주 가입 → 도구 → API 사용관리
NAVER_AD_API_KEY=0100000000xxxxxxxxxxxxxxxxxxxx
NAVER_AD_SECRET_KEY=AQAAAxxxxxxxxxxxxxxxxxxxx
NAVER_AD_CUSTOMER_ID=1234567

# --- 워드프레스 REST API (자동 발행) ---
# 워드프레스 관리자 → 사용자 → 프로필 → 애플리케이션 비밀번호 발급
WP_URL=https://your-blog.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- 수익화 ---
# 구글 애드센스 게시자 ID (ca-pub-xxxxxxxxxxxxxxxx)
ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# 애드센스 광고 슬롯 ID (본문 삽입용)
ADSENSE_SLOT_ID=0000000000
# 쿠팡 파트너스 트래킹 코드 (예: AF1234567)
COUPANG_PARTNERS_TAG=

# --- 운영 설정 ---
# 하루에 발행할 글 수
POSTS_PER_DAY=3
# 발행 상태: draft(초안) | publish(즉시발행) | future(예약)
PUBLISH_STATUS=draft
# 안전장치: true 면 실제 발행 안 하고 로컬 저장만 (테스트용)
DRY_RUN=true
