# ============================================================
#  워드프레스 배포 설정
#  cp .env.example .env  후 값을 바꾸세요. (특히 비밀번호!)
# ============================================================

# 접속 포트 (로컬 테스트용). 실서버는 80/443 리버스프록시 권장.
WP_PORT=8080

# 블로그 주소.
#  - 로컬 테스트: http://localhost:8080
#  - 실서버: https://your-domain.com (도메인 연결 후)
WP_URL=http://localhost:8080
WP_TITLE=내 수익형 블로그

# 관리자 계정 (반드시 강력한 비밀번호로 변경!)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_this_strong_pw
WP_ADMIN_EMAIL=you@example.com

# 데이터베이스 (변경 권장)
WP_DB_NAME=wordpress
WP_DB_USER=wpuser
WP_DB_PASSWORD=change_this_db_pw
WP_DB_ROOT_PASSWORD=change_this_root_pw
