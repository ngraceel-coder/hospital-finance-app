# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올리지 않습니다)

# ── OCR (명세서 스캔용, 6단계부터 필요) ─────────────────────────────
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5

# ── 초기 관리자 계정 (최초 1회 자동 생성) ──────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_NAME=관리자

# ── 결재 규칙 ───────────────────────────────────────────────────────
# 원장이 본인 발주를 셀프 승인 허용(1) / 금지(0)
ALLOW_DIRECTOR_SELF_APPROVE=1
# 금액별 결재 분기 사용(1)/미사용(0) 및 임계액(원)
AMOUNT_BASED_APPROVAL=0
APPROVAL_AMOUNT_THRESHOLD=500000

# ── 알림/품질 기준 ─────────────────────────────────────────────────
EXPIRY_ALERT_DAYS=60
MIN_SHORT_EDGE_PX=1000
BLUR_LAPLACIAN_MIN=100

# ── 기관 정보 ───────────────────────────────────────────────────────
ORG_NAME=온소아청소년과의원
ORG_UNIT=온자람실
